{
  "id": "snap_front_2d",
  "version": 1,
  "status": "draft",
  "name": {
    "tr": "Anlık görüntü: önden 2B metrikler",
    "en": "Snapshot: front 2D metrics"
  },
  "howTo": {
    "tr": "Gard al; başın dairenin ortasında olsun. Dizlerini hafif kırıp gövdenle sola yat, başını sarı balona götür. Daire yeşile dönünce sayılır; ok ortayı gösterince ortaya dön.",
    "en": "Take your guard with your head in the middle of the circle. Bend your knees slightly and lean your body to your left, taking your head to the yellow bubble. It counts when the circle turns green; when the arrow points to the middle, come back."
  },
  "type": "reps",
  "camera": {
    "views": [
      "front"
    ],
    "minVisibleLandmarks": [
      "nose",
      "left_shoulder",
      "right_shoulder",
      "left_wrist",
      "right_wrist",
      "left_hip",
      "right_hip"
    ],
    "minVisibility": 0.6,
    "posture": "standing",
    "setupHint": {
      "tr": "Kamerayı göğüs hizasına, tam karşına koy; 2–3 metre uzaklaş, gard al.",
      "en": "Place the camera at chest height straight in front of you, step back 2–3 meters and take your guard."
    }
  },
  "metrics": {
    "head_l_lh": {
      "lateralLean2d": [
        "nose",
        "left_hip"
      ]
    },
    "head_l_rh": {
      "lateralLean2d": [
        "nose",
        "right_hip"
      ]
    },
    "head_left": {
      "avg": [
        "head_l_lh",
        "head_l_rh"
      ]
    },
    "head_r_lh": {
      "lateralLean2d": [
        "left_hip",
        "nose"
      ]
    },
    "head_r_rh": {
      "lateralLean2d": [
        "right_hip",
        "nose"
      ]
    },
    "head_right": {
      "avg": [
        "head_r_lh",
        "head_r_rh"
      ]
    },
    "torso_l_l": {
      "lateralLean2d": [
        "left_shoulder",
        "left_hip"
      ]
    },
    "torso_l_r": {
      "lateralLean2d": [
        "right_shoulder",
        "right_hip"
      ]
    },
    "torso_left": {
      "avg": [
        "torso_l_l",
        "torso_l_r"
      ]
    },
    "torso_r_l": {
      "lateralLean2d": [
        "left_hip",
        "left_shoulder"
      ]
    },
    "torso_r_r": {
      "lateralLean2d": [
        "right_hip",
        "right_shoulder"
      ]
    },
    "torso_right": {
      "avg": [
        "torso_r_l",
        "torso_r_r"
      ]
    },
    "guard_l": {
      "diffY": [
        "left_wrist",
        "left_shoulder"
      ]
    },
    "guard_r": {
      "diffY": [
        "right_wrist",
        "right_shoulder"
      ]
    },
    "height_l": {
      "chainHeight2d": [
        "nose",
        "left_shoulder",
        "left_hip",
        "left_knee",
        "left_ankle"
      ]
    },
    "height_r": {
      "chainHeight2d": [
        "nose",
        "right_shoulder",
        "right_hip",
        "right_knee",
        "right_ankle"
      ]
    },
    "knee_l": {
      "angle2d": [
        "left_hip",
        "left_knee",
        "left_ankle"
      ]
    },
    "knee_r": {
      "angle2d": [
        "right_hip",
        "right_knee",
        "right_ankle"
      ]
    },
    "knee": {
      "min": [
        "knee_l",
        "knee_r"
      ]
    },
    "lean_w": {
      "sagittalLean": [
        "nose",
        "left_hip"
      ]
    }
  },
  "rep": {
    "metric": "head_left",
    "start": {
      "enter": 0.12,
      "exit": 0.16
    },
    "target": {
      "enter": 0.3,
      "exit": 0.25
    },
    "attemptMinExcursion": 0.06,
    "minDurationMs": 200,
    "maxDurationMs": 2500
  },
  "readyPose": "guard_l > -0.3 and guard_r > -0.3 and head_left < 0.1 and head_right < 0.1 for 1000ms",
  "faults": [
    {
      "id": "guard_dropped",
      "name": {
        "tr": "Gardın düşmesi",
        "en": "Guard dropped"
      },
      "severity": "minor",
      "check": "during_rep: min(guard_l, guard_r) < -0.5",
      "cue": {
        "tr": "Gardını kaldır",
        "en": "Keep your guard up"
      },
      "affectsValidity": false,
      "cooldownMs": 4000,
      "minConsecutiveReps": 1,
      "holdMs": 200
    },
    {
      "id": "neck_only",
      "name": {
        "tr": "Yalnız boyunla kaçma",
        "en": "Slipping with the neck only"
      },
      "severity": "minor",
      "check": "at_turn: torso_left < 0.15",
      "cue": {
        "tr": "Boynunla değil, gövdenle kaç",
        "en": "Slip with your body, not just your neck"
      },
      "affectsValidity": false,
      "cooldownMs": 4000,
      "minConsecutiveReps": 2
    }
  ],
  "smoothing": {
    "method": "one_euro",
    "minCutoff": 2.0,
    "beta": 0.7
  },
  "overlay": {
    "headTarget": {
      "lateral": 0.3,
      "sides": [
        "left"
      ]
    }
  }
}
