{
  "id": "pushup",
  "version": 2,
  "status": "draft",
  "derivedFrom": {
    "id": "pushup",
    "version": 1,
    "commit": "c2fe3fd"
  },
  "name": {
    "tr": "Şınav",
    "en": "Push-up"
  },
  "howTo": {
    "tr": "Yan dönerek elleri omuz altında, vücudun baştan topuğa düz olacak şekilde şınav pozisyonu al. Dirseklerini kırarak göğsünü yere yaklaştır, sonra iterek kollarını aç. Kalçan ne sarksın ne yukarı kalksın.",
    "en": "Side-on to the camera, get into a push-up position with your hands under your shoulders and your body straight from head to heels. Bend your elbows to bring your chest toward the floor, then push back up. Don't let your hips sag or pike."
  },
  "type": "reps",
  "camera": {
    "views": [
      "side"
    ],
    "minVisibleLandmarks": [
      "near_shoulder",
      "near_elbow",
      "near_wrist",
      "near_hip",
      "near_knee",
      "near_ankle"
    ],
    "minVisibility": 0.5,
    "posture": "horizontal",
    "setupHint": {
      "tr": "Kamerayı yere yakın, yan tarafına koy; baştan ayağa tüm vücudun görünsün.",
      "en": "Place the camera low, at your side, so you are fully visible from head to feet."
    }
  },
  "metrics": {
    "elbow_angle": {
      "angle2d": [
        "near_shoulder",
        "near_elbow",
        "near_wrist"
      ]
    },
    "body_line_angle": {
      "angle2d": [
        "near_shoulder",
        "near_hip",
        "near_ankle"
      ]
    },
    "hip_offset": {
      "signedOffset": [
        "near_shoulder",
        "near_hip",
        "near_ankle"
      ]
    }
  },
  "rep": {
    "metric": "elbow_angle",
    "start": {
      "enter": 155,
      "exit": 145
    },
    "target": {
      "enter": 95,
      "exit": 105
    },
    "attemptMinExcursion": 20,
    "minDurationMs": 700,
    "maxDurationMs": 8000
  },
  "readyPose": "elbow_angle > 160 and body_line_angle > 160 for 1500ms",
  "faults": [
    {
      "id": "partial_range",
      "name": {
        "tr": "Yarım iniş",
        "en": "Partial range"
      },
      "severity": "minor",
      "check": "at_turn: elbow_angle > 95",
      "cue": {
        "tr": "Göğsünü biraz daha yere yaklaştır",
        "en": "Lower your chest a bit more"
      },
      "affectsValidity": true,
      "cooldownMs": 4000,
      "minConsecutiveReps": 1
    },
    {
      "id": "hip_sag",
      "name": {
        "tr": "Kalça sarkması",
        "en": "Hip sag"
      },
      "severity": "major",
      "check": "during_rep: hip_offset < -0.06",
      "cue": {
        "tr": "Kalçanı sıkıp vücudunu düz tut",
        "en": "Tighten your core, keep a straight line"
      },
      "affectsValidity": false,
      "cooldownMs": 4000,
      "minConsecutiveReps": 2
    },
    {
      "id": "hip_pike",
      "name": {
        "tr": "Kalça yukarıda",
        "en": "Hips piked"
      },
      "severity": "minor",
      "check": "during_rep: hip_offset > 0.08",
      "cue": {
        "tr": "Kalçanı biraz indir",
        "en": "Lower your hips slightly"
      },
      "affectsValidity": false,
      "cooldownMs": 4000,
      "minConsecutiveReps": 2
    }
  ],
  "smoothing": {
    "method": "one_euro",
    "minCutoff": 1.0,
    "beta": 0.05
  }
}
