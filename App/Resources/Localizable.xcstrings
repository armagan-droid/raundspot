    "onboarding.health.advice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We suggest you talk to your doctor before you start."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamadan önce doktoruna danışmanı öneririz."
          }
        }
      }
    },
    "onboarding.health.q1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has a doctor said you have a heart condition and should exercise only with medical advice?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir doktor kalp rahatsızlığın olduğunu ve yalnız doktor önerisiyle egzersiz yapman gerektiğini söyledi mi?"
          }
        }
      }
    },
    "onboarding.health.q2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you get chest pain or dizziness during exercise or at rest?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Egzersiz sırasında ya da dinlenirken göğüs ağrısı ya da baş dönmesi yaşıyor musun?"
          }
        }
      }
    },
    "onboarding.health.q3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have you had an injury in the last 3 months?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 3 ayda bir sakatlık geçirdin mi?"
          }
        }
      }
    },
    "onboarding.health.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three quick questions (answers are not saved)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç kısa soru (yanıtlar saklanmaz)"
          }
        }
      }
    },
    "onboarding.healthkit.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workouts and estimated active energy can be saved to Apple Health; weight and heart rate can be read for the estimate. Nothing leaves your phone through this app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenmanlar ve tahmini aktif enerji Apple Sağlık'a kaydedilebilir; tahmin için kilo ve nabız okunabilir. Bu uygulama üzerinden hiçbir veri telefonundan çıkmaz."
          }
        }
      }
    },
    "onboarding.healthkit.later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can turn it on later in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha sonra Ayarlar'dan açabilirsin."
          }
        }
      }
    },
