      "comment": "Reflex hint after two wrong answers to the same strike (specs/05); depends on the stance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip the cross to the outside: left."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düze dışa kaç: sola."
          }
        }
      }
    },
