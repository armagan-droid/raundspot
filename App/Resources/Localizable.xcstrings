    "training.camera.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is needed to count your movement. The image is processed on the phone, never saved or sent."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketini saymak için kamera gerekir. Görüntün telefonda işlenir, kaydedilmez, gönderilmez."
