    "training.safety.space": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you have at least 2×2 m of clear space around you? No slippery floor, objects or pets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etrafında en az 2×2 m boş alan var mı? Kaygan zemin, eşya, evcil hayvan olmasın."
          }
        }
      }
    },
    "training.safety.spoken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop. Pause for safety. Resume when you are ready."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dur. Güvenlik için mola. Hazır olunca devam et."
          }
        }
      }
    },
