    "settings.text.medical": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not medical advice. Stop if you feel pain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tıbbi tavsiye değildir. Ağrı hissedersen dur."
          }
        }
      }
    },
    "settings.text.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no server and no account. Your camera picture is processed on this phone only, is not saved and is not sent anywhere. Your profile and workouts stay in this app on your phone and in your own phone backup. The app contains no analytics, advertising or tracking. You can export or delete all your data in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu ve hesap yoktur. Kamera görüntün yalnız bu telefonda işlenir, kaydedilmez ve hiçbir yere gönderilmez. Profilin ve antrenmanların bu uygulamada, telefonunda ve kendi telefon yedeğinde kalır. Uygulamada analitik, reklam ya da izleme yoktur. Tüm verilerini Ayarlar'dan dışa aktarabilir ya da silebilirsin."
          }
        }
      }
    },
    "settings.text.terms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version is for adults (18+). It is a training aid, not medical advice. Train in a safe, clear space and stop if you feel pain. (Draft text, to be reviewed.)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürüm yetişkinler (18+) içindir. Bir antrenman yardımcısıdır, tıbbi tavsiye değildir. Güvenli ve boş bir alanda çalış, ağrı hissedersen dur. (Taslak metin, gözden geçirilecek.)"
          }
        }
      }
    },
